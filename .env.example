# Required: the token BotFather gave you (123456789:AA...). Set it in Railway, never commit it.
TELEGRAM_BOT_TOKEN=
# Required: Telegram chat id(s) allowed to use the bot, comma-separated (DM @userinfobot to get yours; group ids are negative).
ALLOWED_CHAT_IDS=
# Optional: free CoinGecko Demo key (coingecko.com/en/api). ~3x faster price history; falls back to GeckoTerminal.
COINGECKO_DEMO_KEY=
# Where cache + sqlite live. On Railway this is the volume mounted at /data.
DATA_DIR=/data
# Optional tuning (defaults shown)
FULL_SCAN_HOURS=4
LIGHT_CHECK_MINUTES=30
ALERT_DEDUPE_HOURS=24
CHAINS=solana,base
TOP_N=8
MAX_DEEP=30
# Local testing only: print messages instead of sending them
DRY_RUN=0
